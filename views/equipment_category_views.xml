<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_category_list" model="ir.ui.view">
        <field name="name">equipment.category.list</field>
        <field name="model">equipment.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="item_count"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_category_form" model="ir.ui.view">
        <field name="name">equipment.category.form</field>
        <field name="model">equipment.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_items"
                                icon="fa-cubes" invisible="not id" >
                            <field name="item_count" widget="statinfo" string="Items" />
                        </button>
                    </div>


                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                    </group>

                    <notebook>
                        <page string="Sub-Categories">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="item_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record id="view_equipment_category_search" model="ir.ui.view">
        <field name="name">equipment.category.search</field>
        <field name="model">equipment.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id"/>
                <filter string="Top-Level" name="top_level" domain="[('parent_id', '=', False)]"/>

                <filter string="Parent Category" name="group_parent" context="{'group_by': 'parent_id'}"/>

            </search>
        </field>
    </record>

    <record id="action_equipment_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">equipment.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
