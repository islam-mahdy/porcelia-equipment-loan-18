<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_item_kanban" model="ir.ui.view">
        <field name="name">equipment.item.kanban</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <aside>
                            <field name="image_128" widget="image"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="code" class="text-muted"/>
                            <field name="category_id"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'available'"
                                   decoration-warning="state == 'on_loan'"
                                   decoration-danger="state == 'scrapped'"
                                   decoration-info="state == 'maintenance'"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_equipment_item_list" model="ir.ui.view">
        <field name="name">equipment.item.list</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="daily_rate"/>
                <field name="condition_score" widget="condition_gauge" options="{'segments': 5}"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'on_loan'"
                       decoration-danger="state == 'scrapped'"
                       decoration-info="state == 'maintenance'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_item_form" model="ir.ui.view">
        <field name="name">equipment.item.form</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_maintenance" type="object" string="Send to Maintenance"
                            invisible="unavailable_state or state == 'on_loan'"/>
                    <button name="action_scrap" type="object" string="Scrap"
                            invisible="unavailable_state == 'scrapped' or state == 'on_loan'"/>
                    <button name="action_back_in_service" type="object" string="Back in Service"
                            invisible="not unavailable_state"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,on_loan"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loans" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="loan_count" widget="statinfo" string="Loans"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Laptop Pro 14"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <field name="unavailable_state" invisible="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="daily_rate"/>
                            <field name="condition_score" widget="condition_gauge" options="{'segments': 10}"/>
                            <field name="total_days_on_loan"/>
                        </group>
                    </group>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record id="view_equipment_item_search" model="ir.ui.view">
        <field name="name">equipment.item.search</field>
        <field name="model">equipment.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>


                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>

                <filter name="on_loan" string="On Loan" domain="[('state', '=', 'on_loan')]"/>

                <separator/>

                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>


                <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>

            </search>
        </field>
    </record>

    <record id="action_equipment_item" model="ir.actions.act_window">
        <field name="name">Items</field>
        <field name="res_model">equipment.item</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
