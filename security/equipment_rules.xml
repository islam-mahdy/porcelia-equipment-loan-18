<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Users only see/edit their own loans;
     managers see everything.
    -->

    <record id="rule_equipment_loan_user" model="ir.rule">
        <field name="name">Equipment Loan: own loans only</field>
        <field name="model_id" ref="model_equipment_loan"/>
        <field name="domain_force">[('borrower_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_equipment_user'))]"/>
    </record>

    <record id="rule_equipment_loan_manager" model="ir.rule">
        <field name="name">Equipment Loan: managers see all</field>
        <field name="model_id" ref="model_equipment_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_equipment_manager'))]"/>
    </record>


